<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="CcUpdatesPanel" parent="CcPanel">
    <child>
      <!-- AdwNavigationView so the "What's new" detail can push as a
           subpage and inherit the standard back-arrow without us
           reimplementing it. -->
      <object class="AdwNavigationView" id="nav_view">

        <!-- Root page: hero + update state + Whats-new entry -->
        <child>
          <object class="AdwNavigationPage">
            <property name="title" translatable="yes">Software Updates</property>
            <property name="tag">root</property>
            <child>
              <object class="AdwPreferencesPage">

                <!-- Hero: current image identity -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwActionRow" id="hero_row">
                        <property name="title">System Image</property>
                        <property name="subtitle">Detecting…</property>
                        <property name="subtitle-lines">2</property>
                        <property name="subtitle-selectable">True</property>
                        <property name="title-selectable">True</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">drive-harddisk-symbolic</property>
                            <property name="pixel-size">32</property>
                            <style>
                              <class name="accent"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Update state + Check / Install + What's new affordance -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwActionRow" id="update_state_row">
                        <property name="title" translatable="yes">Press Check to query for updates</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkButton" id="install_button">
                                <property name="label" translatable="yes">Install</property>
                                <property name="visible">False</property>
                                <signal name="clicked" handler="on_install_button_clicked" object="CcUpdatesPanel" swapped="no"/>
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="check_button">
                                <property name="label" translatable="yes">Check</property>
                                <signal name="clicked" handler="on_check_button_clicked" object="CcUpdatesPanel" swapped="no"/>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="whats_new_row">
                        <property name="title" translatable="yes">What's new in this update</property>
                        <property name="subtitle" translatable="yes">See the package diff and key components</property>
                        <property name="activatable">True</property>
                        <signal name="activated" handler="on_whats_new_activated" object="CcUpdatesPanel" swapped="no"/>
                        <child type="suffix">
                          <object class="GtkImage">
                            <property name="icon-name">go-next-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="change_image_row">
                        <property name="title" translatable="yes">Change image</property>
                        <property name="subtitle" translatable="yes">Switch variant, stream, or pin a previous build</property>
                        <property name="activatable">True</property>
                        <signal name="activated" handler="on_change_image_activated" object="CcUpdatesPanel" swapped="no"/>
                        <child type="suffix">
                          <object class="GtkImage">
                            <property name="icon-name">go-next-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Per-module install progress; hidden until Install fires. -->
                <child>
                  <object class="AdwPreferencesGroup" id="progress_group">
                    <property name="title" translatable="yes">Installing…</property>
                    <property name="visible">False</property>
                    <child>
                      <object class="AdwActionRow" id="system_row">
                        <property name="title" translatable="yes">System image</property>
                        <property name="subtitle" translatable="yes">Waiting…</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="flatpak_row">
                        <property name="title">Flatpak</property>
                        <property name="subtitle" translatable="yes">Waiting…</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="brew_row">
                        <property name="title">Homebrew</property>
                        <property name="subtitle" translatable="yes">Waiting…</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="distrobox_row">
                        <property name="title">Distrobox</property>
                        <property name="subtitle" translatable="yes">Waiting…</property>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </template>
</interface>
